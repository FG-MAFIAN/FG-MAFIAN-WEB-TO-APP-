{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/create-app",
      "destination": "/create-app.html"
    },
    {
      "source": "/builds",
      "destination": "/builds.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "functions": {
    "api/build.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
